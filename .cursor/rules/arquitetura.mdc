#### Passo 8: Criar Adapter Out
```java
// adapters/out/InsertProductAdapter.java
package br.com.fsj.salesplatform.adapters.out;

import br.com.fsj.salesplatform.adapters.out.repository.ProductRepository;
import br.com.fsj.salesplatform.adapters.out.repository.mapper.ProductEntityMapper;
import br.com.fsj.salesplatform.application.core.domain.Product;
import br.com.fsj.salesplatform.application.ports.out.InsertProductOutputPort;
import org.springframework.stereotype.Component;

@Component
public class InsertProductAdapter implements InsertProductOutputPort {

    private final ProductRepository repository;
    private final ProductEntityMapper mapper;

    public InsertProductAdapter(ProductRepository repository, ProductEntityMapper mapper) {
        this.repository = repository;
        this.mapper = mapper;
    }

    @Override
    public Product insert(Product domain) {
        var entity = mapper.toEntity(domain);
        var saved = repository.save(entity);
        return mapper.toDomain(saved);
    }
}
```

